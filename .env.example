# ==========================================
# Employee Management System - Environment Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# Authentication / JWT (Planned for future phases)
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRES_IN=1d

# Frontend Configuration
# In local dev: http://localhost:5000/api
# In Docker production: /api (proxied via Nginx)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000/api
